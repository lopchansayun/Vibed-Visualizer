# Judge0 CE endpoint.
# For production, point this to your own backend proxy so Judge0 credentials
# are not exposed in the browser.
VITE_JUDGE0_API_URL=https://ce.judge0.com

# Optional. Only needed when your Judge0 instance requires X-Auth-Token.
# Do not treat a VITE_* value as a secret: Vite exposes it to browser code.
# VITE_JUDGE0_API_KEY=
